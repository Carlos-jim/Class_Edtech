# Copia este archivo a .env y ajusta los valores. .env NUNCA se versiona.

# --- Base de datos (solo desarrollo local) ---
DB_NAME=tutor
DB_USER=tutor
DB_PASSWORD=change-me-local
DB_PORT=5433

# --- Aplicación (docker compose up --build) ---
APP_PORT=8080

# --- Seguridad ---
# Secreto HMAC para firmar JWT (mínimo 32 bytes). Genera uno con: openssl rand -base64 48
JWT_SECRET=

# --- Proveedor de IA ---
# mock = respuestas simuladas, no requiere clave (por defecto)
# groq = Groq API (gratuita): https://console.groq.com/keys
LLM_PROVIDER=mock
GROQ_API_KEY=
# Modelo de chat (opcional). Lista: https://console.groq.com/docs/models
GROQ_MODEL=llama-3.3-70b-versatile

# --- Voz a texto ---
# Por defecto usa el mismo proveedor que LLM_PROVIDER (mock | groq). La clave es la misma GROQ_API_KEY.
# STT_PROVIDER=groq
# GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo

# --- Límites de uso (peticiones por minuto) ---
# RATE_LIMIT_LOGIN_PER_MINUTE=20
# RATE_LIMIT_QUESTIONS_PER_MINUTE=15
# RATE_LIMIT_TRANSCRIPTIONS_PER_MINUTE=15
