# Copia este archivo a .env y ajusta los valores. .env NUNCA se versiona.

# --- Base de datos (solo desarrollo local) ---
DB_NAME=tutor
DB_USER=tutor
DB_PASSWORD=change-me-local
DB_PORT=5433

# --- Aplicación (docker compose up --build) ---
APP_PORT=8080

# --- Red del backend (solo Linux, si Groq responde 403 desde la red bridge de Docker) ---
# COMPOSE_FILE=docker-compose.yml:docker-compose.host.yml
# Puerto del backend en el host con ese override (distinto de APP_PORT)
# BACKEND_PORT=8081

# --- Seguridad ---
# Secreto HMAC para firmar JWT (mínimo 32 bytes). Genera uno con: openssl rand -base64 48
JWT_SECRET=

# --- IA: proveedor del tutor y de la voz ---
# gemini (por defecto, gratuito y sin tarjeta) | groq | mistral | cerebras. API compatible con OpenAI.
LLM_PROVIDER=gemini
# STT_PROVIDER=gemini   # voz a texto; por defecto, el mismo que LLM_PROVIDER (con cerebras: pon gemini)

# Google Gemini (chat + voz). Clave gratuita, sin tarjeta: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Varios modelos separados por comas = relevo: si uno tarda, se pide también al siguiente y gana el primero.
# GEMINI_MODEL=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-flash-lite-latest
# GEMINI_TRANSCRIPTION_MODEL=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-flash-lite-latest

# Cerebras (opcional, chat muy rápido; no transcribe voz). AVISO: pide vincular una tarjeta. https://cloud.cerebras.ai
# Para usarlo: LLM_PROVIDER=cerebras y STT_PROVIDER=gemini
CEREBRAS_API_KEY=
# CEREBRAS_MODEL=gpt-oss-120b

# Groq (opcional). Clave gratuita: https://console.groq.com/keys
# Nota: Groq bloquea algunas redes/regiones (HTTP 403 "Access denied").
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo

# Mistral (opcional). Desde oct-2026 su plan gratuito no permite claves de API (requiere plan de pago).
MISTRAL_API_KEY=
# MISTRAL_MODEL=mistral-small-latest
# MISTRAL_TRANSCRIPTION_MODEL=voxtral-mini-latest

# --- Límites de uso (peticiones por minuto) ---
# RATE_LIMIT_LOGIN_PER_MINUTE=20
# RATE_LIMIT_QUESTIONS_PER_MINUTE=15
# RATE_LIMIT_TRANSCRIPTIONS_PER_MINUTE=15
